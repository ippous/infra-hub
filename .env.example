# Copier en .env sur le VPS (le fichier .env n'est jamais commité)

# Mode : Caddy autonome (ports 80/443)…
COMPOSE_FILE=docker-compose.yml:docker-compose.tls.yml
# …ou derrière un proxy existant, joint par le réseau Docker indiqué :
# COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml
# INFRAHUB_RESEAU_PROXY=shetland-registre_default

INFRAHUB_DOMAIN=infra.jaume-eric.com

# Accès provisoire (Caddy basic_auth). Hash : docker run --rm caddy:2 caddy hash-password
# Garder les apostrophes : le hash contient des « $ ».
INFRAHUB_UTILISATEUR=eric
INFRAHUB_MOT_DE_PASSE_HASH='$2a$14$remplacer-par-le-hash'

POSTGRES_DB=infrahub
POSTGRES_USER=infrahub
POSTGRES_PASSWORD=change-moi

# Version des images (renseignée par le déploiement ; « latest » sinon)
# INFRAHUB_TAG=latest

# Collecteur Vercel (facultatif) : jeton créé sur vercel.com/account/settings/tokens, portée = l'équipe
# VERCEL_JETON=
# VERCEL_EQUIPE=team_...
