# Adresse du site : le domaine en mode autonome (TLS automatique), « :80 » derrière un proxy existant.
# En mode autonome, le DNS de {$INFRAHUB_DOMAIN} doit pointer vers l'IP du VPS.
{
	servers {
		# Derrière un proxy du même serveur : faire confiance à ses en-têtes X-Forwarded-*.
		trusted_proxies static private_ranges
	}
}

{$INFRAHUB_ADRESSE} {
	encode zstd gzip

	# Protection provisoire tant que l'interface n'a pas sa propre authentification.
	# Hash à générer avec : docker run --rm caddy:2 caddy hash-password
	basic_auth {
		{$INFRAHUB_UTILISATEUR} {$INFRAHUB_MOT_DE_PASSE_HASH}
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy web:8080
}
